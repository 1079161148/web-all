{
  "name": "@admin/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenAPI 契约生成产物 + 请求客户端（设计文档 §十）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts"
  },
  "scripts": {
    "spec": "node scripts/prepare-spec.mjs",
    "gen": "node scripts/gen-check.mjs",
    "gen:check": "node scripts/gen-check.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "orval": "^8.32.0",
    "vitest": "^3.2.7"
  }
}
