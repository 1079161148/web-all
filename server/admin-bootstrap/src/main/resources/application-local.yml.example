# =====================================================================
# 本地开发配置模板
#
# 使用方法：
#   复制本文件为 application-local.yml（同目录），填入自己的本机凭据。
#   application-local.yml 已加入 .gitignore —— **真实密码不要提交到仓库**。
#
# 该 profile 由 application.yml 的 spring.profiles.active 默认激活（默认值 local）。
# 文件不存在时不会报错，等价于无覆盖，因此新成员 clone 后可以直接启动，
# 连不上数据库时再来创建本文件。
# =====================================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/webadmin?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 你的本机数据库密码

  data:
    redis:
      host: localhost
      # ⚠️ 本项目用 6381，不是默认的 6379。
      # 本机 6379 被另一个项目（ecommerce）的容器占用，6380 被原生 Redis 占用。
      # 本项目用专属容器与端口，避免与其他项目共用同一个 Redis 实例。
      # 启动方式：docker compose up -d redis   （容器名 webadmin-redis）
      port: ${REDIS_PORT:6381}
      # Redis 若设置了密码，在此填写
      password:

# 本地开发建议打开 SQL 日志，便于核对多租户条件与数据权限条件是否被正确拼接
logging:
  level:
    com.webadmin.infrastructure.persistence.mapper: DEBUG
    org.springframework.jdbc.core: DEBUG
