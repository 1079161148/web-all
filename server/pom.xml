<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      聚合 POM + 父 POM 合一。
      设计文档 §4.4 的目录树把聚合 POM 画成独立的 server/admin-parent/ 目录；
      这里采用更标准的做法：server/pom.xml 同时承担聚合与父 POM 职责，
      避免模块出现 ../admin-common 这类跨目录 <module> 路径。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.webadmin</groupId>
    <artifactId>admin-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>admin-parent</name>
    <description>企业级多租户中台系统 - 后端（DDD 分层 + 契约优先）</description>

    <modules>
        <module>admin-common</module>
        <module>admin-domain</module>
        <module>admin-application</module>
        <module>admin-infrastructure</module>
        <module>admin-interfaces</module>
        <module>admin-bootstrap</module>
        <module>admin-test-support</module>
    </modules>

    <properties>
        <!--
          ⚠️ 设计文档 §2.1 基线为 JDK 25 LTS（虚拟线程 + ScopedValue）。
          本机若只有 JDK 21，可在命令行覆盖： mvn -Djava.version=21 clean install
          （JDK 21 下虚拟线程可用，但 ScopedValue 仍是预览特性，TenantContext 需回退到 ThreadLocal）
        -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 已核实的版本（Maven Central） -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>3.1.1</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <archunit.version>1.3.0</archunit.version>
        <hutool.version>5.8.34</hutool.version>

        <!--
          ⚠️ 以下两个 BOM 必须显式导入。
          实测确认：Spring Boot 4.0.8 的 BOM 不再托管 Spring Modulith 与 Testcontainers，
          缺失会导致 'dependencies.dependency.version is missing' 而无法解析 POM。
          - Spring Modulith 2.0.x 与 Spring Boot 4.0.x 同线（2.1.x 对应 Boot 4.1）
          - Testcontainers 版本取自 spring-boot-testcontainers:4.0.8 的 POM（2.0.5），保证与 @ServiceConnection 对齐
        -->
        <spring-modulith.version>2.0.8</spring-modulith.version>
        <testcontainers-bom.version>2.0.5</testcontainers-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ===== 外部 BOM 导入 ===== -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.webadmin</groupId>
                <artifactId>admin-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webadmin</groupId>
                <artifactId>admin-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webadmin</groupId>
                <artifactId>admin-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webadmin</groupId>
                <artifactId>admin-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webadmin</groupId>
                <artifactId>admin-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webadmin</groupId>
                <artifactId>admin-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 持久化：MyBatis-Plus 官方 Spring Boot 4 starter（设计文档 §21 P0 验证项 1） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
              ⚠️ MyBatis-Plus 3.5.9 起把 SQL 解析相关能力拆到独立模块：
              PaginationInnerInterceptor / TenantLineInnerInterceptor / TenantLineHandler
              已从 mybatis-plus-extension 移到 mybatis-plus-jsqlparser，
              不显式引入会报「找不到符号」（实测确认）。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 接口文档：OpenAPI 契约源（设计文档 §十） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- 对象映射：编译期生成，禁止 BeanUtils 反射拷贝 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 工具 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- 架构测试：把设计文档的红线变成 CI 门禁 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 所有模块通用：编译期代码生成，不进入运行时 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          ================================================================
          构建环境门禁（Enforcer）
          ================================================================

          为什么这条规则必须存在 —— 这是实测踩出来的，不是预防性设计：

          本机同时装了 JDK 25 与 JDK 21。当 `mvn` 在没有 JAVA_HOME 的 shell 里运行时，
          Maven 会使用 PATH 上的 JDK 21，而 target/ 下的 .class 是上一次用 JDK 25
          编译的（class file 69.0）。此时：

            ① 增量构建**不会重新编译**（源码没变，class 文件比源码新）→ 编译阶段静默通过
            ② surefire fork 出 JDK 21 的 JVM 去加载 class 69.0 → 失败

          报错长这样：
            TenantTest has been compiled by a more recent version of the Java Runtime
            (class file version 69.0), this version of the Java Runtime only recognizes
            class file versions up to 65.0

          **这句话里没有一个字提到「你的 JDK 版本不对」。**它看起来像编译产物损坏，
          实际是环境问题。排查它要花掉的时间，远超加一条规则的成本。

          ⚠️ 版本范围写 `[${java.version},)` 而不是硬编码 `[25,)`：
          本 POM 的 java.version 允许通过 `-Djava.version=21` 覆盖（见上方 properties 注释），
          硬编码 25 会让那条受支持的回退路径直接被自己的门禁拦死。
          用属性插值后，"要求的 JVM 版本"与"实际编译目标"永远一致 ——
          **门禁必须跟随配置，而不是与配置各说各话。**
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <!-- validate 是最早的阶段，错误在做任何编译之前就暴露 -->
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                    <message>
                                        当前 Maven 使用的 JVM 低于本项目的编译目标 ${java.version}。
                                        请设置 JAVA_HOME 指向 JDK ${java.version} 后重试
                                        （否则会出现编译器能过、测试 JVM 加载不了 class 文件的怪象）。
                                    </message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!-- 注解处理器：Lombok + MapStruct 的顺序必须保持 Lombok 在前 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Amapstruct.defaultComponentModel=spring</arg>
                            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
